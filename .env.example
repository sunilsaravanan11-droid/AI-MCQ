# Copy this file to ".env" and fill in your values.

# Which AI provider to use: "groq" (free & fast, recommended) or "openai"
AI_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Flask secret key (any random string)
FLASK_SECRET_KEY=change-this-to-a-random-secret-string

# Local app login credentials
LOGIN_USERNAME=student
LOGIN_EMAIL=student@example.com
LOGIN_PASSWORD=change-this-password
